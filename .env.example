# ─────────────────────────────────────────────────────────────────────
#  Órbita — variáveis de ambiente
#
#  Copie para .env e preencha.  O .env NUNCA vai pro git (ver .gitignore).
#  Gere os segredos com os comandos indicados em cada bloco.
# ─────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info

# ── Banco de dados ───────────────────────────────────────────────────
# Instância própria, separada do Supabase do Método CRM.
POSTGRES_USER=orbita
POSTGRES_PASSWORD=troque-esta-senha-em-producao
POSTGRES_DB=orbita
POSTGRES_PORT=5432
DATABASE_URL=postgresql://orbita:troque-esta-senha-em-producao@localhost:5432/orbita

# ── Redis (fila de execução) ─────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── API ──────────────────────────────────────────────────────────────
API_PORT=3001
# URL pública da API. É a base das URLs de webhook mostradas no painel.
PUBLIC_API_URL=http://localhost:3001
# Origem do painel, para o CORS. Em produção: https://app.seudominio.com
WEB_ORIGIN=http://localhost:5173

# ── Criptografia das credenciais  (OBRIGATÓRIO) ──────────────────────
# Chave AES-256-GCM que protege as chaves de API guardadas no banco.
# Fica FORA do banco, só aqui. Se perder, as credenciais são irrecuperáveis.
#   openssl rand -base64 32
ENCRYPTION_KEY=

# ── Autenticação ─────────────────────────────────────────────────────
# Segredo de assinatura dos JWT.
#   openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Owner criado no primeiro boot (seed). Depois disso, troque a senha pelo painel.
OWNER_EMAIL=voce@seudominio.com
OWNER_PASSWORD=

# ── Execução ─────────────────────────────────────────────────────────
WORKER_CONCURRENCY=5
ACTION_DEFAULT_TIMEOUT_MS=30000
ACTION_DEFAULT_RETRIES=2
# Dias de retenção do histórico de execuções antes da poda automática.
EXECUTION_RETENTION_DAYS=90

# ── Credenciais de integrações ───────────────────────────────────────
# ATENÇÃO: chaves de API de integrações (Gemini, WhatsApp, etc.) NÃO vão
# aqui. Elas são cadastradas pela aba Integrações do painel e ficam
# criptografadas no banco. Este arquivo guarda só segredos de
# infraestrutura da própria plataforma.
